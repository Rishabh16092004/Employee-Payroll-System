<!DOCTYPE html>
<html lang="en">

<head>
    <title>Edit Employee</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h2>Edit Employee</h2>

    <form action="/edit/<%= employee.id %>" method="POST">

        <label>Name</label>
        <input type="text" name="name" value="<%= employee.name %>">

        <label>Profile Image</label>
        <div class="profile-container">

            <label>
                <input type="radio" name="profileImage" value="Ananya.webp" <%=employee.profileImage==="Ananya.webp"
                    ? "checked" : "" %>>
                <img src="/images/Ananya.webp">
            </label>

            <label>
                <input type="radio" name="profileImage" value="Aryan.avif" <%=employee.profileImage==="Aryan.avif"
                    ? "checked" : "" %>>
                <img src="/images/Aryan.avif">
            </label>

            <label>
                <input type="radio" name="profileImage" value="Kavya.webp" <%=employee.profileImage==="Kavya.webp"
                    ? "checked" : "" %>>
                <img src="/images/Kavya.webp">
            </label>

            <label>
                <input type="radio" name="profileImage" value="Priya.webp" <%=employee.profileImage==="Priya.webp"
                    ? "checked" : "" %>>
                <img src="/images/Priya.webp">
            </label>

        </div>

        <label>Gender</label>
        <div class="radio-group">
            <label><input type="radio" name="gender" value="Male" <%=employee.gender==="Male" ? "checked" : "" %>>
                Male</label>

            <label><input type="radio" name="gender" value="Female" <%=employee.gender==="Female" ? "checked" : "" %>>
                Female</label>
        </div>

        <label>Department</label>
        <div class="radio-group">
            <label><input type="radio" name="department" value="HR" <%=employee.department==="HR" ? "checked" : "" %>>
                HR</label>

            <label><input type="radio" name="department" value="Sales" <%=employee.department==="Sales" ? "checked" : ""
                    %>> Sales</label>

            <label><input type="radio" name="department" value="Finance" <%=employee.department==="Finance" ? "checked"
                    : "" %>> Finance</label>

            <label><input type="radio" name="department" value="Engineer" <%=employee.department==="Software Engineer"
                    ? "checked" : "" %>>Software Engineer</label>
        </div>

        <label>Salary</label>
        <select name="salary">
            <option <%=employee.salary==30000?"selected":"" %>>30000</option>
            <option <%=employee.salary==40000?"selected":"" %>>40000</option>
            <option <%=employee.salary==50000?"selected":"" %>>50000</option>
            <option <%=employee.salary==60000?"selected":"" %>>60000</option>
        </select>

        <label>Start Date</label>
        <input type="date" name="startDate" value="<%= employee.startDate %>">

        <div class="buttons">
            <button type="submit">Update</button>
            <a href="/" class="cancel-link">Cancel</a>
        </div>

    </form>

</body>

</html>